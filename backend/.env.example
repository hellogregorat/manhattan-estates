# Скопируй этот файл в .env и заполни своими значениями

PORT=5000

# Строка подключения к Postgres.
# Для локального запуска БЕЗ Docker (нужен свой установленный Postgres) — как ниже.
# Для запуска через docker-compose эта переменная переопределяется автоматически
# (compose подставляет адрес контейнера с базой) — можешь не менять.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manhattan_estates

# Разрешённый источник для CORS — адрес, с которого фронтенд обращается к API
CORS_ORIGIN=http://localhost:5173

# Секрет для подписи JWT-токенов — поставь любую длинную случайную строку
JWT_SECRET=change-me-to-a-random-secret-string

# Какого AI-провайдера использовать для чата поддержки: gemini (бесплатно), anthropic или openai
CHAT_PROVIDER=gemini

# Бесплатный вариант — ключ без привязки карты: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Нужен, если CHAT_PROVIDER=anthropic — ключ с console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Нужен, если CHAT_PROVIDER=openai — ключ с platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
